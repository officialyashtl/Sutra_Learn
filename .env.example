# =====================================================================
# SUTRA LEARN — Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# Backend Runtime & Server Configuration
# ---------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sutra-learn.vercel.app

# ---------------------------------------------------------------------
# Security & Cryptography
# ---------------------------------------------------------------------
# HMAC-SHA256 secret key for signing bearer session tokens
# IMPORTANT: In production, generate a 64-character random hex string
SUTRA_SECRET_KEY=sutra-development-insecure-secret-key-change-in-production-2026
SESSION_EXPIRY_HOURS=24

# ---------------------------------------------------------------------
# Database Persistence
# ---------------------------------------------------------------------
# Path to SQLite database file. Set SUTRA_DB_PATH for tests or persistent disks
SUTRA_DB_PATH=backend/sutra_learn.db

# ---------------------------------------------------------------------
# Multi-Model AI Infrastructure Configuration
# ---------------------------------------------------------------------
# Operating mode: auto | cloud | local | offline
AI_MODE=auto
AI_PRIMARY_PROVIDER=gemini
AI_OFFLINE_MODE=false
AI_ENABLE_FALLBACK=true
AI_ENABLE_DETERMINISTIC=true

# Provider Enablement Flags
AI_ENABLE_GEMINI=true
AI_ENABLE_QWEN=true
AI_ENABLE_GEMMA=true

# ---------------------------------------------------------------------
# Tier 1: Google Gemini API (Cloud)
# ---------------------------------------------------------------------
# Optional: Set your valid Google Gemini API key
# If omitted, invalid, or billing-restricted, the platform automatically
# falls back to local Ollama models (Qwen / Gemma) and deterministic engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------
# Tier 2 & 3: Ollama Local Models
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QWEN_MODEL=qwen3.5:4b
OLLAMA_GEMMA_MODEL=gemma4:e2b
QWEN_TIMEOUT_SECONDS=45.0
GEMMA_TIMEOUT_SECONDS=20.0
OLLAMA_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------
# Resilience & Circuit Breakers
# ---------------------------------------------------------------------
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60.0
AI_MAX_USER_INPUT_CHARS=8000
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_TOTAL_ATTEMPTS=4

# ---------------------------------------------------------------------
# Frontend Configuration (Vite)
# ---------------------------------------------------------------------
# Base URL pointing to the FastAPI backend service
VITE_API_URL=http://127.0.0.1:8000
